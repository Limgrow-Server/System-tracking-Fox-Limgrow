model AndroidStoreProfile {
  id                 String                     @id @default(uuid()) @db.Uuid
  storeAccountName   String                     @unique @map("store_account_name")
  linkStore          String?                    @map("link_store")
  avatarUrl          String?                    @map("avatar_url")
  contactEmail       String?                    @map("contact_email")
  supportPhone       String?                    @map("support_phone")
  websiteUrl         String?                    @map("website_url")
  status             MappingStatus              @default(ACTIVE)
  createdAt          DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  mappings           AndroidStoreMapping[]
  credentials        AndroidCredential[]
  iapTransactions    IapAndroid[]
  rtdnConfig         AndroidRtdnConfig?
  rtdnEvents         AndroidIapRtdnEvent[]
  iapOrders          AndroidIapOrder[]
  iapLifecycleEvents AndroidIapLifecycleEvent[]
  reviewTarget       ReviewStoreTarget?

  @@index([status, storeAccountName], map: "android_store_profiles_status_name_idx")
  @@map("android_store_profiles")
}

model AndroidStoreMapping {
  id                         String                            @id @default(uuid()) @db.Uuid
  storeProfileId             String                            @map("store_profile_id") @db.Uuid
  storeAccountName           String                            @map("store_account_name")
  appId                      String?                           @map("app_id")
  appName                    String                            @map("app_name")
  appIconUrl                 String?                           @map("app_icon_url")
  appLink                    String?                           @map("app_link")
  packageName                String                            @map("package_name")
  firebaseAppId              String?                           @map("firebase_app_id")
  firebaseAnalyticsApiSecret String?                           @map("firebase_analytics_api_secret") @db.Text
  adjustAppToken             String?                           @map("adjust_app_token")
  adjustEventToken           String?                           @map("adjust_event_token")
  adjustTrialStartedEventToken String?                         @map("adjust_trial_started_event_token")
  status                     MappingStatus                     @default(ACTIVE)
  createdAt                  DateTime                          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime                          @updatedAt @map("updated_at") @db.Timestamptz(6)
  storeProfile               AndroidStoreProfile               @relation(fields: [storeProfileId], references: [id], onDelete: Restrict)
  reviews                    AndroidStoreReview[]
  reviewSyncState            AndroidStoreReviewSyncState?
  reviewFetchRuns            AndroidStoreReviewFetchRun[]
  reviewFetchSchedule        AndroidStoreReviewFetchSchedule?
  replyTemplates             AndroidStoreReviewReplyTemplate[]
  reviewTarget               ReviewAppTarget?
  iapTransactions            IapAndroid[]
  rtdnEvents                 AndroidIapRtdnEvent[]
  iapOrders                  AndroidIapOrder[]
  iapLifecycleEvents         AndroidIapLifecycleEvent[]

  @@unique([storeProfileId, appName], map: "android_store_mappings_profile_app_name_key")
  @@unique([storeProfileId, appId], map: "android_store_mappings_profile_app_id_key")
  @@unique([packageName], map: "android_store_mappings_package_key")
  @@index([appId, status], map: "android_store_mappings_app_id_status_idx")
  @@index([packageName, status], map: "android_store_mappings_package_status_idx")
  @@index([status, appName, packageName, id], map: "android_store_mappings_status_app_name_package_idx")
  @@index([storeProfileId, updatedAt(sort: Desc)], map: "android_store_mappings_profile_updated_idx")
  @@index([storeAccountName], map: "android_store_mappings_store_name_idx")
  @@index([updatedAt(sort: Desc)], map: "android_store_mappings_updated_idx")
  @@map("android_store_mappings")
}

model AndroidStoreReview {
  id                      String              @id @default(uuid()) @db.Uuid
  storeMappingId          String              @map("store_mapping_id") @db.Uuid
  reviewAppTargetId       String?             @map("review_app_target_id") @db.Uuid
  reviewId                String              @map("review_id")
  authorName              String?             @map("author_name")
  rating                  Int?
  reviewText              String?             @map("review_text") @db.Text
  originalText            String?             @map("original_text") @db.Text
  reviewerLanguage        String?             @map("reviewer_language")
  device                  String?
  deviceMetadata          Json?               @map("device_metadata")
  androidOsVersion        Int?                @map("android_os_version")
  appVersionCode          Int?                @map("app_version_code")
  appVersionName          String?             @map("app_version_name")
  thumbsUpCount           Int?                @map("thumbs_up_count")
  thumbsDownCount         Int?                @map("thumbs_down_count")
  userCommentUpdatedAt    DateTime?           @map("user_comment_updated_at") @db.Timestamptz(6)
  developerReplyText      String?             @map("developer_reply_text") @db.Text
  developerReplyUpdatedAt DateTime?           @map("developer_reply_updated_at") @db.Timestamptz(6)
  rawReview               Json?               @map("raw_review")
  fetchedAt               DateTime            @default(now()) @map("fetched_at") @db.Timestamptz(6)
  createdAt               DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  storeMapping            AndroidStoreMapping @relation(fields: [storeMappingId], references: [id], onDelete: Cascade)
  appTarget               ReviewAppTarget?    @relation(fields: [reviewAppTargetId], references: [id], onDelete: SetNull)

  @@unique([storeMappingId, reviewId], map: "android_store_reviews_mapping_review_key")
  @@index([reviewAppTargetId], map: "android_store_reviews_app_target_idx")
  @@index([storeMappingId, userCommentUpdatedAt(sort: Desc), fetchedAt(sort: Desc)], map: "android_store_reviews_mapping_user_updated_idx")
  @@index([storeMappingId, rating], map: "android_store_reviews_mapping_rating_idx")
  @@index([developerReplyUpdatedAt], map: "android_store_reviews_reply_updated_idx")
  @@map("android_store_reviews")
}

model AndroidStoreReviewSyncState {
  id                  String              @id @default(uuid()) @db.Uuid
  storeMappingId      String              @unique @map("store_mapping_id") @db.Uuid
  status              ReviewSyncStatus    @default(IDLE)
  lastFetchStartedAt  DateTime?           @map("last_fetch_started_at") @db.Timestamptz(6)
  lastFetchFinishedAt DateTime?           @map("last_fetch_finished_at") @db.Timestamptz(6)
  lastSuccessAt       DateTime?           @map("last_success_at") @db.Timestamptz(6)
  lastReviewUpdatedAt DateTime?           @map("last_review_updated_at") @db.Timestamptz(6)
  lockedAt            DateTime?           @map("locked_at") @db.Timestamptz(6)
  lockedBy            String?             @map("locked_by")
  lastErrorCode       String?             @map("last_error_code")
  lastErrorMessage    String?             @map("last_error_message") @db.Text
  lastFetchedCount    Int                 @default(0) @map("last_fetched_count")
  lastUpsertedCount   Int                 @default(0) @map("last_upserted_count")
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  storeMapping        AndroidStoreMapping @relation(fields: [storeMappingId], references: [id], onDelete: Cascade)

  @@index([status, lastFetchStartedAt], map: "android_store_review_sync_states_status_started_idx")
  @@index([lastSuccessAt], map: "android_store_review_sync_states_success_idx")
  @@map("android_store_review_sync_states")
}

model AndroidStoreReviewFetchRun {
  id               String                           @id @default(uuid()) @db.Uuid
  storeMappingId   String                           @map("store_mapping_id") @db.Uuid
  sourceScheduleId String?                          @map("source_schedule_id") @db.Uuid
  triggerType      ReviewFetchTrigger               @default(SCHEDULED) @map("trigger_type")
  status           ReviewFetchRunStatus             @default(PENDING)
  scanMode         ReviewFetchScanMode              @default(LIMITED) @map("scan_mode")
  stopReason       ReviewFetchStopReason?           @map("stop_reason")
  scheduledFor     DateTime?                        @map("scheduled_for") @db.Timestamptz(6)
  nextAttemptAt    DateTime?                        @map("next_attempt_at") @db.Timestamptz(6)
  attemptCount     Int                              @default(0) @map("attempt_count")
  maxAttempts      Int                              @default(3) @map("max_attempts")
  lockedAt         DateTime?                        @map("locked_at") @db.Timestamptz(6)
  lockedBy         String?                          @map("locked_by")
  maxResults       Int                              @default(100) @map("max_results")
  requestCount     Int                              @default(0) @map("request_count")
  nextPageToken    String?                          @map("next_page_token") @db.Text
  pagesFetched     Int                              @default(0) @map("pages_fetched")
  reviewsFetched   Int                              @default(0) @map("reviews_fetched")
  reviewsUpserted  Int                              @default(0) @map("reviews_upserted")
  errorCode        String?                          @map("error_code")
  errorMessage     String?                          @map("error_message") @db.Text
  startedAt        DateTime?                        @map("started_at") @db.Timestamptz(6)
  finishedAt       DateTime?                        @map("finished_at") @db.Timestamptz(6)
  createdAt        DateTime                         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                         @updatedAt @map("updated_at") @db.Timestamptz(6)
  storeMapping     AndroidStoreMapping              @relation(fields: [storeMappingId], references: [id], onDelete: Cascade)
  sourceSchedule   AndroidStoreReviewFetchSchedule? @relation(fields: [sourceScheduleId], references: [id], onDelete: SetNull)

  @@unique([storeMappingId, triggerType, scheduledFor], map: "android_store_review_fetch_runs_mapping_trigger_scheduled_key")
  @@index([status, nextAttemptAt], map: "android_store_review_fetch_runs_status_next_attempt_idx")
  @@index([status, lockedAt], map: "android_store_review_fetch_runs_status_locked_idx")
  @@index([storeMappingId, createdAt], map: "android_store_review_fetch_runs_mapping_created_idx")
  @@index([sourceScheduleId, scheduledFor], map: "android_store_review_fetch_runs_schedule_for_idx")
  @@index([createdAt], map: "android_store_review_fetch_runs_created_idx")
  @@map("android_store_review_fetch_runs")
}

model AndroidStoreReviewFetchSchedule {
  id               String                       @id @default(uuid()) @db.Uuid
  storeMappingId   String                       @unique @map("store_mapping_id") @db.Uuid
  status           ReviewFetchScheduleStatus    @default(ACTIVE)
  intervalHours    Int                          @default(8) @map("interval_hours")
  nextRunAt        DateTime                     @map("next_run_at") @db.Timestamptz(6)
  lastRunAt        DateTime?                    @map("last_run_at") @db.Timestamptz(6)
  lastStatus       ReviewFetchRunStatus?        @map("last_status")
  lastErrorCode    String?                      @map("last_error_code")
  lastErrorMessage String?                      @map("last_error_message") @db.Text
  lockedAt         DateTime?                    @map("locked_at") @db.Timestamptz(6)
  lockedBy         String?                      @map("locked_by")
  runCount         Int                          @default(0) @map("run_count")
  createdBy        String?                      @map("created_by")
  updatedBy        String?                      @map("updated_by")
  createdAt        DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)
  storeMapping     AndroidStoreMapping          @relation(fields: [storeMappingId], references: [id], onDelete: Cascade)
  fetchRuns        AndroidStoreReviewFetchRun[]

  @@index([status, nextRunAt], map: "android_store_review_fetch_schedules_status_next_idx")
  @@index([lockedAt], map: "android_store_review_fetch_schedules_locked_idx")
  @@map("android_store_review_fetch_schedules")
}

model AndroidStoreReviewReplyTemplate {
  id             String              @id @default(uuid()) @db.Uuid
  storeMappingId String              @map("store_mapping_id") @db.Uuid
  rating         Int
  replyText      String              @map("reply_text") @db.Text
  isActive       Boolean             @default(false) @map("is_active")
  createdBy      String?             @map("created_by")
  updatedBy      String?             @map("updated_by")
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  storeMapping   AndroidStoreMapping @relation(fields: [storeMappingId], references: [id], onDelete: Cascade)

  @@unique([storeMappingId, rating], map: "android_store_review_reply_templates_mapping_rating_key")
  @@index([storeMappingId, isActive], map: "android_store_review_reply_templates_mapping_active_idx")
  @@map("android_store_review_reply_templates")
}

model AndroidCredential {
  id                 String              @id @default(uuid()) @db.Uuid
  storeProfileId     String              @map("store_profile_id") @db.Uuid
  credentialRef      String              @unique @map("credential_ref")
  vaultSecretId      String?             @map("vault_secret_id") @db.Uuid
  vaultSecretName    String?             @map("vault_secret_name")
  vaultSecretVersion Int                 @default(1) @map("vault_secret_version")
  storeAccountName   String              @map("store_account_name")
  linkStore          String?             @map("link_store")
  avatarUrl          String?             @map("avatar_url")
  privateKeyId       String?             @map("private_key_id")
  clientEmail        String?             @map("client_email")
  projectId          String?             @map("project_id")
  status             CredentialStatus    @default(ACTIVE)
  description        String?
  createdBy          String?             @map("created_by")
  rotatedBy          String?             @map("rotated_by")
  lastUsedAt         DateTime?           @map("last_used_at") @db.Timestamptz(6)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  storeProfile       AndroidStoreProfile @relation(fields: [storeProfileId], references: [id], onDelete: Restrict)

  @@unique([storeProfileId], map: "android_credentials_profile_key")
  @@index([credentialRef, status], map: "android_credentials_lookup_idx")
  @@index([storeAccountName, status], map: "android_credentials_store_status_idx")
  @@index([updatedAt(sort: Desc)], map: "android_credentials_updated_idx")
  @@index([vaultSecretId], map: "android_credentials_vault_secret_id_idx")
  @@index([vaultSecretName], map: "android_credentials_vault_secret_name_idx")
  @@map("android_credentials")
}

model IapAndroid {
  id                        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeProfileId            String?   @map("store_profile_id") @db.Uuid
  storeMappingId            String?   @map("store_mapping_id") @db.Uuid
  packageName               String    @map("package_name")
  productId                 String    @map("product_id")
  purchaseKind              String    @map("purchase_kind")
  purchaseToken             String    @map("purchase_token")
  orderId                   String?   @map("order_id")
  linkedPurchaseToken       String?   @map("linked_purchase_token")
  state                     String
  acknowledged              Boolean   @default(false)
  consumed                  Boolean?
  autoRenewing              Boolean?  @map("auto_renewing")
  purchaseDate              DateTime? @map("purchase_date") @db.Timestamptz(6)
  expiresDate               DateTime? @map("expires_date") @db.Timestamptz(6)
  revenueMicros             BigInt?   @map("revenue_micros")
  currency                  String?
  regionCode                String?   @map("region_code")
  basePlanId                String?   @map("base_plan_id")
  offerId                   String?   @map("offer_id")
  currentOrderId            String?   @map("current_order_id")
  offerPhase                String?   @map("offer_phase")
  isTrial                   Boolean   @default(false) @map("is_trial")
  trialStartedAt            DateTime? @map("trial_started_at") @db.Timestamptz(6)
  trialEndsAt               DateTime? @map("trial_ends_at") @db.Timestamptz(6)
  hadFreeTrial              Boolean   @default(false) @map("had_free_trial")
  ingestionSource           String    @default("client") @map("ingestion_source")
  externalAccountId         String?   @map("external_account_id")
  externalProfileId         String?   @map("external_profile_id")
  userId                    String?   @map("user_id")
  appInstanceId             String?   @map("app_instance_id")
  installationId            String?   @map("installation_id")
  adjustAdid                String?   @map("adjust_adid")
  gpsAdid                   String?   @map("gps_adid")
  lastNotificationAt        DateTime? @map("last_notification_at") @db.Timestamptz(6)
  lastRtdnEventId           String?   @map("last_rtdn_event_id") @db.Uuid
  providerEtag              String?   @map("provider_etag")
  lastProviderSyncAt        DateTime? @map("last_provider_sync_at") @db.Timestamptz(6)
  entitlementActive         Boolean?  @map("entitlement_active")
  supersededByPurchaseToken String?   @map("superseded_by_purchase_token")
  isTestPurchase            Boolean   @default(false) @map("is_test_purchase")
  rawReceipt                Json?     @map("raw_receipt")
  verifiedAt                DateTime  @map("verified_at") @db.Timestamptz(6)
  createdAt                 DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  storeProfile    AndroidStoreProfile?       @relation(fields: [storeProfileId], references: [id], onDelete: SetNull)
  storeMapping    AndroidStoreMapping?       @relation(fields: [storeMappingId], references: [id], onDelete: SetNull)
  lineItems       AndroidIapLineItem[]
  orders          AndroidIapOrder[]
  rtdnEvents      AndroidIapRtdnEvent[]
  lifecycleEvents AndroidIapLifecycleEvent[]

  @@unique([packageName, purchaseToken])
  @@index([packageName, productId])
  @@index([packageName, storeProfileId, verifiedAt], map: "iap_android_package_profile_verified_idx")
  @@index([packageName, storeProfileId, purchaseDate], map: "iap_android_package_profile_purchase_idx")
  @@index([state, purchaseDate])
  @@index([storeProfileId])
  @@index([storeMappingId, lastNotificationAt(sort: Desc)], map: "iap_android_mapping_notification_idx")
  @@index([currentOrderId], map: "iap_android_current_order_idx")
  @@index([lastRtdnEventId], map: "iap_android_last_rtdn_event_idx")
  @@map("iap_android")
}

model AndroidRtdnConfig {
  id                      String              @id @default(uuid()) @db.Uuid
  storeProfileId          String              @unique @map("store_profile_id") @db.Uuid
  projectId               String              @map("project_id")
  topicName               String              @map("topic_name")
  subscriptionName        String              @unique @map("subscription_name")
  oidcAudience            String              @map("oidc_audience")
  pushServiceAccountEmail String              @map("push_service_account_email")
  enabled                 Boolean             @default(false)
  createdAt               DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  storeProfile            AndroidStoreProfile @relation(fields: [storeProfileId], references: [id], onDelete: Cascade)

  @@index([enabled, projectId], map: "android_rtdn_configs_enabled_project_idx")
  @@index([oidcAudience, enabled], map: "android_rtdn_configs_audience_enabled_idx")
  @@index([topicName], map: "android_rtdn_configs_topic_idx")
  @@map("android_rtdn_configs")
}

model AndroidIapRtdnEvent {
  id                          String                     @id @default(uuid()) @db.Uuid
  storeProfileId              String                     @map("store_profile_id") @db.Uuid
  storeMappingId              String?                    @map("store_mapping_id") @db.Uuid
  purchaseId                  String?                    @map("purchase_id") @db.Uuid
  topicName                   String                     @map("topic_name")
  subscriptionName            String                     @map("subscription_name")
  pubsubMessageId             String                     @map("pubsub_message_id")
  publishTime                 DateTime?                  @map("publish_time") @db.Timestamptz(6)
  deliveryAttempt             Int?                       @map("delivery_attempt")
  packageName                 String?                    @map("package_name")
  eventTime                   DateTime                   @map("event_time") @db.Timestamptz(6)
  notificationKind            String                     @map("notification_kind")
  source                      String                     @default("google_play_rtdn")
  notificationType            Int?                       @map("notification_type")
  notificationName            String?                    @map("notification_name")
  purchaseToken               String?                    @map("purchase_token") @db.Text
  pendingRefundTokenEncrypted Json?                      @map("pending_refund_token_encrypted")
  productId                   String?                    @map("product_id")
  orderId                     String?                    @map("order_id")
  requiresAction              Boolean                    @default(false) @map("requires_action")
  actionStatus                String?                    @map("action_status")
  actionDueAt                 DateTime?                  @map("action_due_at") @db.Timestamptz(6)
  status                      String                     @default("queued")
  attemptCount                Int                        @default(0) @map("attempt_count")
  maxAttempts                 Int                        @default(8) @map("max_attempts")
  nextAttemptAt               DateTime                   @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  lockedAt                    DateTime?                  @map("locked_at") @db.Timestamptz(6)
  lockedBy                    String?                    @map("locked_by")
  lastError                   String?                    @map("last_error") @db.Text
  rawPayload                  Json                       @map("raw_payload")
  attributes                  Json                       @default("{}")
  payloadSha256               String                     @map("payload_sha256")
  receivedAt                  DateTime                   @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt                 DateTime?                  @map("processed_at") @db.Timestamptz(6)
  createdAt                   DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  storeProfile                AndroidStoreProfile        @relation(fields: [storeProfileId], references: [id], onDelete: Restrict)
  storeMapping                AndroidStoreMapping?       @relation(fields: [storeMappingId], references: [id], onDelete: Restrict)
  purchase                    IapAndroid?                @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  queueOutbox                 AndroidIapQueueOutbox?
  lifecycleEvents             AndroidIapLifecycleEvent[]

  @@unique([topicName, pubsubMessageId], map: "android_iap_rtdn_events_topic_message_key")
  @@index([status, nextAttemptAt, receivedAt], map: "android_iap_rtdn_events_status_due_idx")
  @@index([packageName, eventTime(sort: Desc)], map: "android_iap_rtdn_events_package_event_idx")
  @@index([purchaseToken], map: "android_iap_rtdn_events_purchase_token_idx")
  @@index([orderId], map: "android_iap_rtdn_events_order_idx")
  @@index([requiresAction, actionDueAt], map: "android_iap_rtdn_events_action_due_idx")
  @@index([storeMappingId, receivedAt(sort: Desc)], map: "android_iap_rtdn_events_mapping_received_idx")
  @@map("android_iap_rtdn_events")
}

model AndroidIapLineItem {
