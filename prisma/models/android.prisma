model AndroidIapOrder {
  id                     String                  @id @default(uuid()) @db.Uuid
  purchaseId             String?                 @map("purchase_id") @db.Uuid
  storeProfileId         String                  @map("store_profile_id") @db.Uuid
  storeMappingId         String                  @map("store_mapping_id") @db.Uuid
  packageName            String                  @map("package_name")
  purchaseToken          String?                 @map("purchase_token") @db.Text
  orderId                String                  @map("order_id")
  productId              String?                 @map("product_id")
  orderKind              String                  @map("order_kind")
  classification         String?
  offerPhase             String?                 @map("offer_phase")
  state                  String
  createdAtProvider      DateTime?               @map("created_at_provider") @db.Timestamptz(6)
  processedAt            DateTime?               @map("processed_at") @db.Timestamptz(6)
  refundedAt             DateTime?               @map("refunded_at") @db.Timestamptz(6)
  lastEventAt            DateTime?               @map("last_event_at") @db.Timestamptz(6)
  grossAmountMicros      BigInt?                 @map("gross_amount_micros")
  taxMicros              BigInt?                 @map("tax_micros")
  developerRevenueMicros BigInt?                 @map("developer_revenue_micros")
  refundedAmountMicros   BigInt?                 @map("refunded_amount_micros")
  currency               String?
  quantity               Int?
  refundedQuantity       Int?                    @map("refunded_quantity")
  isTrial                Boolean                 @default(false) @map("is_trial")
  rawOrder               Json                    @map("raw_order")
  lastSyncedAt           DateTime                @map("last_synced_at") @db.Timestamptz(6)
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  purchase               IapAndroid?             @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  storeProfile           AndroidStoreProfile     @relation(fields: [storeProfileId], references: [id], onDelete: Restrict)
  storeMapping           AndroidStoreMapping     @relation(fields: [storeMappingId], references: [id], onDelete: Restrict)
  deliveryJobs           AndroidIapDeliveryJob[]

  @@unique([packageName, orderId], map: "android_iap_orders_package_order_key")
  @@index([purchaseId, createdAtProvider(sort: Desc)], map: "android_iap_orders_purchase_created_idx")
  @@index([packageName, createdAtProvider(sort: Desc)], map: "android_iap_orders_package_created_idx")
  @@index([state, lastEventAt], map: "android_iap_orders_state_event_idx")
  @@map("android_iap_orders")
}

model AndroidIapLifecycleEvent {
  id               String                  @id @default(uuid()) @db.Uuid
  purchaseId       String?                 @map("purchase_id") @db.Uuid
  rtdnEventId      String?                 @map("rtdn_event_id") @db.Uuid
  storeProfileId   String                  @map("store_profile_id") @db.Uuid
  storeMappingId   String                  @map("store_mapping_id") @db.Uuid
  packageName      String                  @map("package_name")
  eventKey         String                  @unique @map("event_key")
  eventType        String                  @map("event_type")
  notificationType Int?                    @map("notification_type")
  orderId          String?                 @map("order_id")
  occurredAt       DateTime                @map("occurred_at") @db.Timestamptz(6)
  previousState    String?                 @map("previous_state")
  newState         String?                 @map("new_state")
  amountMicros     BigInt?                 @map("amount_micros")
  currency         String?
  payload          Json
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  purchase         IapAndroid?             @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  rtdnEvent        AndroidIapRtdnEvent?    @relation(fields: [rtdnEventId], references: [id], onDelete: SetNull)
  storeProfile     AndroidStoreProfile     @relation(fields: [storeProfileId], references: [id], onDelete: Restrict)
  storeMapping     AndroidStoreMapping     @relation(fields: [storeMappingId], references: [id], onDelete: Restrict)
  deliveryJobs     AndroidIapDeliveryJob[]

  @@index([purchaseId, occurredAt(sort: Desc)], map: "android_iap_lifecycle_purchase_occurred_idx")
  @@index([storeMappingId, occurredAt(sort: Desc)], map: "android_iap_lifecycle_mapping_occurred_idx")
  @@index([eventType, occurredAt(sort: Desc)], map: "android_iap_lifecycle_type_occurred_idx")
  @@index([rtdnEventId], map: "android_iap_lifecycle_rtdn_event_idx")
  @@map("android_iap_lifecycle_events")
}

model AndroidIapQueueOutbox {
  id              String              @id @default(uuid()) @db.Uuid
  rtdnEventId     String              @unique @map("rtdn_event_id") @db.Uuid
  messageType     String              @default("android-iap.reconcile.v1") @map("message_type")
  dedupeKey       String              @unique @map("dedupe_key")
  payload         Json
  status          String              @default("pending")
  availableAt     DateTime            @default(now()) @map("available_at") @db.Timestamptz(6)
  publishedAt     DateTime?           @map("published_at") @db.Timestamptz(6)
  publishAttempts Int                 @default(0) @map("publish_attempts")
  lockedAt        DateTime?           @map("locked_at") @db.Timestamptz(6)
  lockedBy        String?             @map("locked_by")
  lastError       String?             @map("last_error") @db.Text
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  rtdnEvent       AndroidIapRtdnEvent @relation(fields: [rtdnEventId], references: [id], onDelete: Cascade)

  @@index([status, availableAt, createdAt], map: "android_iap_queue_outbox_publish_due_idx")
  @@index([lockedAt], map: "android_iap_queue_outbox_locked_idx")
  @@map("android_iap_queue_outbox")
}

model AndroidIapDeliveryJob {
  id                 String                   @id @default(uuid()) @db.Uuid
  lifecycleEventId   String                   @map("lifecycle_event_id") @db.Uuid
  orderId            String?                  @map("order_id") @db.Uuid
  destination        String
  eventName          String                   @default("purchase") @map("event_name")
  amountMicros       BigInt?                  @map("amount_micros")
  currency           String?
  purchaseOccurredAt DateTime?                @map("purchase_occurred_at") @db.Timestamptz(6)
  status             String                   @default("pending")
  availableAt        DateTime                 @default(now()) @map("available_at") @db.Timestamptz(6)
  publishedAt        DateTime?                @map("published_at") @db.Timestamptz(6)
  publishAttempts    Int                      @default(0) @map("publish_attempts")
  deliveryAttempts   Int                      @default(0) @map("delivery_attempts")
  maxAttempts        Int                      @default(5) @map("max_attempts")
  lockedAt           DateTime?                @map("locked_at") @db.Timestamptz(6)
  lockedBy           String?                  @map("locked_by")
  responseStatus     Int?                     @map("response_status")
  lastError          String?                  @map("last_error") @db.Text
  result             Json                     @default("{}")
  deliveredAt        DateTime?                @map("delivered_at") @db.Timestamptz(6)
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  lifecycleEvent     AndroidIapLifecycleEvent @relation(fields: [lifecycleEventId], references: [id], onDelete: Cascade)
  order              AndroidIapOrder?         @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([lifecycleEventId, destination, eventName], map: "android_iap_delivery_jobs_lifecycle_destination_event_key")
  @@unique([orderId, destination, eventName], map: "android_iap_delivery_jobs_order_destination_event_key")
  @@index([status, availableAt, createdAt], map: "android_iap_delivery_jobs_publish_due_idx")
  @@index([orderId], map: "android_iap_delivery_jobs_order_idx")
  @@index([lockedAt], map: "android_iap_delivery_jobs_locked_idx")
  @@map("android_iap_delivery_jobs")
}
